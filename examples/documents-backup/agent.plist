<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.__USER__.documents-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/Library/Scripts/AgentDesk/documents-backup.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BACKUP_VOLUME</key>
		<string>/Volumes/Backup</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/com.__USER__.documents-backup/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/com.__USER__.documents-backup/stderr.log</string>
</dict>
</plist>
