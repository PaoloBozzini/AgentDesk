<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.__USER__.local-web-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/Library/Scripts/AgentDesk/local-web-server.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>WorkingDirectory</key>
	<string>__HOME__/Sites</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PORT</key>
		<string>8000</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/com.__USER__.local-web-server/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/com.__USER__.local-web-server/stderr.log</string>
</dict>
</plist>
