<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.__USER__.disk-space-alert</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/Library/Scripts/AgentDesk/disk-space-alert.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MIN_FREE_PERCENT</key>
		<string>10</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/com.__USER__.disk-space-alert/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/com.__USER__.disk-space-alert/stderr.log</string>
</dict>
</plist>
